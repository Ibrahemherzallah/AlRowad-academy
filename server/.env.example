# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/rawad_academy

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cookies
COOKIE_SECURE=false

# WhatsApp (Phase 1 stub — Meta / Twilio / 360dialog)
WHATSAPP_PROVIDER=stub
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Email (Resend / Nodemailer)
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
EMAIL_FROM=no-reply@rawad.academy
